# Настройки бота. Копировать в .env НЕ нужно: на сервере значения берутся из ~/Myfreelab/.env.
# Здесь только названия переменных, секретов в файле нет.

# ВКонтакте: Управление сообществом -> Работа с API
VK_GROUP_ID=
VK_TOKEN=

# Telegram: бот и чат владельца для уведомлений о записях
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ProxyAPI (proxyapi.ru)
PROXYAPI_KEY=
PROXYAPI_MODEL=gpt-4.1-mini

# Необязательно
# PROXYAPI_BASE_URL=https://api.proxyapi.ru/openai/v1
# LEADS_SHEET_URL=адрес веб-приложения Google Apps Script для строки в таблице
# BOT_DB_PATH=data/bot.db
